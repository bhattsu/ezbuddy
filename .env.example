# -----------------------------------------------------------------------------
# US Legal Pro - Unified RAG + IDP Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.
# -----------------------------------------------------------------------------

# --- Environment ---
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
APP_NAME=US Legal Pro - Unified RAG + IDP

# --- AWS ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# --- RAG: Bedrock ---
# LLM model ID is MODEL_ID under IDP: LLM (single source of truth)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- RAG: Defaults ---
# Court-rules RAG uses OpenSearch by default
DEFAULT_VECTOR_STORE=opensearch
DEFAULT_RAG_TYPE=naive
DEFAULT_TOP_K=10

# --- Amazon OpenSearch Service (court rules / RAG vectors) ---
# Domain endpoint from AWS console (include https://)
OPENSEARCH_ENDPOINT=https://search-your-domain-xxxxx.us-east-1.es.amazonaws.com
# OPENSEARCH_REGION=us-east-1
OPENSEARCH_USE_AWS_AUTH=true
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true
# Fine-grained access control (optional if using master user instead of IAM-only)
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
OPENSEARCH_KNN_ENGINE=nmslib
COURT_RULES_VECTOR_STORE=opensearch
COURT_RULES_COLLECTION=court_rules
COURT_RULES_TOP_K=3

# --- RAG / Legal filing: RDS PostgreSQL (app DB; optional pgvector fallback) ---
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=
RDS_USERNAME=
RDS_PASSWORD=

# --- IDP: Extractor ---
# AWS Textract + S3 (requires BUCKET_NAME)
EXTRACTOR_TYPE=AWS_textract
BUCKET_NAME=
# AWS_textract = AWS Textract + S3 (requires BUCKET_NAME)
# goml_custom_extractor = Local libraries (offline; no AWS for extraction)
EXTRACTOR_TYPE=goml_custom_extractor
BUCKET_NAME=goml-uslegalpro-dev
# Legal package ZIP uploads (use existing bucket folders)
S3_DOCUMENTS_REPO_PREFIX=documents-repo
S3_KNOWLEDGE_PREFIX=knowledge
S3_PACKAGE_ASSETS_PREFIX=documents-repo
# Example: s3://goml-uslegalpro-dev/documents-repo/petition.ftl

# --- Legal filing chatbot / document APIs ---
DOCUMENT_TEMPLATE_S3_KEY=
DOCUMENT_GENERATION_API_URL=http://localhost:8000/api/generate
DOCUMENT_ANALYSIS_API_URL=http://localhost:8000/api/analyze
CHATBOT_WS_ENABLED=true

# --- US Legal Pro codes API (dynamic Excel dropdowns at runtime) ---
USLEGALPRO_API_BASE_URL=https://api-stage.uslegalpro.com
# USLEGALPRO_CLIENT_TOKEN=GENS77
# USLEGALPRO_AUTH_TOKEN=

# --- IDP: LLM ---
LLM_PROVIDER=bedrock
# Prefer inference profile IDs (us./eu./apac. prefix). Base IDs like
# anthropic.claude-... often return "model identifier is invalid" on InvokeModel.
MODEL_ID=us.anthropic.claude-sonnet-4-6
LLM_TIMEOUT=1800
DOC_GEN_TIMEOUT=1800
DOC_GEN_PAGES_PER_CHUNK=2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- IDP: File limits ---
MAX_FILE_SIZE_MB=100
MAX_PAGES_PER_REQUEST=50
MAX_BATCH_FILES=10

# --- IDP: Auth (none | api_key | bearer | jwt) ---
AUTH_METHOD=none

# --- IDP: Rate limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
